# 复制本文件为 .env，填入密钥后重启服务。.env 不会被提交到 Git。

# AI 接口（OpenAI 兼容格式）。默认是 DeepSeek，换成通义千问、智谱等只需改地址和模型名。
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# 服务端口。HOST=0.0.0.0 表示同一局域网的电脑也能访问；只想本机访问就改成 127.0.0.1
PORT=8787
HOST=0.0.0.0

# 没有访问口令，所以对 AI 调用限流：每个访问者每小时次数、全站每天次数
RATE_PER_IP_HOUR=60
RATE_GLOBAL_DAY=500
